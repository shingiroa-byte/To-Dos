# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it's already listed in .gitignore.

# Your Supabase (or any Postgres) connection string.
# In Supabase: Project Settings > Database > Connection string (URI, pooled).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# From @BotFather on Telegram after creating your bot.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Fallback chat ID used when a task doesn't specify its own chat_id and no
# workspace-specific ID below is set. Get yours by messaging your bot once,
# then visiting: https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Optional: route Personal and Work reminders to different chats
# (e.g. your own DM for Personal, a team group for Work).
# Each falls back to TELEGRAM_CHAT_ID above if left unset.
TELEGRAM_CHAT_ID_PERSONAL=123456789
TELEGRAM_CHAT_ID_WORK=-100987654321

PORT=3000
